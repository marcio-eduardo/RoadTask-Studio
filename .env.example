# ==============================================================================
# Exemplo de Configuração do Supabase (Banco de Dados em Nuvem)
# ==============================================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publica_ou_anon_do_supabase
SUPABASE_SECRET_KEY=sua_chave_secreta_ou_service_role_do_supabase
SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json

# Tabela do Backend
SUPABASE_TABLE=projects

# ==============================================================================
# Ambiente Vercel & Deploy
# ==============================================================================
VERCEL_ENV=development
VERCEL_URL=seu-projeto.vercel.app
VERCEL_REGION=gru1

# ==============================================================================
# Variáveis Públicas do Frontend (Vite)
# ==============================================================================
VITE_API_URL=/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_publica_ou_anon_do_supabase
